# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Set ONE of these:
# classic reCAPTCHA v3 site key (register the secret key in Firebase console → App Check → reCAPTCHA)
VITE_RECAPTCHA_V3_KEY=
# or a reCAPTCHA Enterprise / Fraud Defense site key
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Optional: fixed App Check debug token (register it in Firebase console → App Check → Manage debug tokens).
# Set VITE_APPCHECK_DEBUG=true to also use the debug token in a production build (e.g. for judges).
VITE_APPCHECK_DEBUG_TOKEN=
VITE_APPCHECK_DEBUG=false
